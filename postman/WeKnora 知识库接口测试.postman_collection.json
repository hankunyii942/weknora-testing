  "item": [
    {
      "name": "A01 查询知识库列表",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"状态码为 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"success 为 true\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.success).to.eql(true);\r\n});\r\n\r\npm.test(\"返回的 data 是数组\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.data).to.be.an(\"array\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/knowledge-bases",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "knowledge-bases"
          ]
        }
      },
      "response": []
    },
    {
      "name": "A02 创建知识库",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"状态码为 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"success 为 true\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n});\r\n\r\npm.test(\"返回的名称包含 Postman测试库\", function () {\r\n    pm.expect(body.data.name).to.include(\"Postman测试库\");\r\n});\r\n\r\npm.collectionVariables.set(\"kb_id\", body.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Postman测试库-{{$timestamp}}\",\r\n    \"description\": \"Postman 自动化测试创建\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/knowledge-bases",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "knowledge-bases"
          ]
        }
      },
      "response": []
    },
    {
      "name": "A03 名称为空",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"状态码为 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});\r\n\r\npm.test(\"success 为 false\", function () {\r\n    pm.expect(body.success).to.eql(false);\r\n});\r\n\r\npm.test(\"错误信息提示名称不能为空\", function () {\r\n    pm.expect(body.error.message).to.eql(\"name cannot be empty\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
