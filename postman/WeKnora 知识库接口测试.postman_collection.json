          "host": [
            "{{base_url}}"
          ],
          "path": [
            "knowledge-bases"
          ]
        }
      },
      "response": []
    },
    {
      "name": "A04 不带Token返回401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"状态码为 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"错误信息包含 Unauthorized\", function () {\r\n    pm.expect(body.error).to.include(\"Unauthorized\");\r\n});\r\n\r\npm.test(\"没有返回知识库数据\", function () {\r\n    pm.expect(body).to.not.have.property(\"data\");\r\n});"
            ]
          }
        }
      ],
